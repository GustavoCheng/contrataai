{
  "expo": {
    "name": "ContrataAí",
    "slug": "contrataai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.contrataai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.contrataai.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "O ContrataAí usa suas fotos no seu perfil e na vitrine da loja.",
          "cameraPermission": "O ContrataAí usa a câmera para você tirar fotos do perfil e da loja."
        }
      ],
      "expo-font"
    ],
    "scheme": "contrataai",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
