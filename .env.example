# Servidor na nuvem (projeto Supabase "contrataai", região de São Paulo).
# A chave "publishable" é pública por definição: ela vai dentro do app e só permite o que as
# regras de acesso do banco (RLS) deixam. Copie este arquivo para .env.
EXPO_PUBLIC_SUPABASE_URL=https://pxpghoicyyraezfokxlc.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kecDJm-fgQndd1oR6U5f8Q_shsItnvC

# Para desenvolver com o Supabase local (Docker), crie um arquivo .env.local com as duas linhas
# abaixo. Ele tem prioridade sobre o .env; apague-o para voltar à nuvem.
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY de `npx supabase status`>
# No celular, o app troca 127.0.0.1 pelo endereço do computador sozinho, em qualquer rede.
