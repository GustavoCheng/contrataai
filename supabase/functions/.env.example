# Segredos das Edge Functions. Copie para supabase/functions/.env (não vai para o git).
# Local: carregado no `npm run db:start`. Nuvem: enviado pelo `npm run cloud:setup`.

# Asaas: use a chave do SANDBOX (começa com $aact_hmlg_), entre aspas simples por causa do "$".
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY='$aact_hmlg_...'
# Token que o Asaas envia no header asaas-access-token dos webhooks (32+ caracteres aleatórios).
ASAAS_WEBHOOK_TOKEN=
# Segredo que assina os QR Codes de check-in/check-out (32+ bytes aleatórios).
CHECKPOINT_SECRET=
# Opcional no ambiente local, necessário na nuvem para o CEP trazer as coordenadas (distância
# nos cards). Chave gratuita em https://awesomeapi.com.br (100 mil consultas por mês).
AWESOMEAPI_KEY=
